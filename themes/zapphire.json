{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Zapphire",
  "author": "dryrunner",
  "themes": [
    {
      "name": "Zapphire",
      "appearance": "dark",
      "style": {
        "editor.background": "#181e29",
        "editor.foreground": "#efefef",
        "terminal.background": "#131820",
        "tab.active_background": "#181e29",
        "tab.inactive_background": "#212a39",
        "panel.background": "#1c2431",
        "status_bar.background": "#131820",
        "border": "#263040",
        "accent": "#399EF4",
        "element.background": "#263041",
        "element.hover": "#FFFFFF1a",
        "element.selected": "#399EF480",
        "editor.line_number": "#FFFFFF4d",
        "editor.active_line_number": "#399EF4",
        "editor.selection_background": "#153958",
        "editor.cursor": "#ffffff",
        "syntax": {
          "comment": {
            "color": "#535a6b",
            "font_style": "italic"
          },
          "string": {
            "color": "#DA6771"
          },
          "number": {
            "color": "#e5949b"
          },
          "boolean": {
            "color": "#399EF4"
          },
          "keyword": {
            "color": "#399EF4"
          },
          "function": {
            "color": "#fff099"
          },
          "type": {
            "color": "#4EB071"
          },
          "variable": {
            "color": "#9fcff9"
          },
          "constant": {
            "color": "#399EF4"
          },
          "property": {
            "color": "#21C5C7"
          },
          "operator": {
            "color": "#399EF4"
          }
        },
        "version_control": {
          "added": "#399EF4",
          "modified": "#4EB071",
          "deleted": "#DA6771"
        },
        "players": [],
        "editor.gutter.background": "#181e29",
        "toolbar.background": "#181e29",
        "ghost_element.selected": "#399EF480",
        "terminal.foreground": "#efefef"
      }
    }
  ],
  "isUserGenerated": true
}
